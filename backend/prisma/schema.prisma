generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String           @id @default(uuid())
  teslaSubject           String?          @unique
  email                  String           @unique
  // Written by the RevenueCat webhook (src/routes/subscriptions.ts) — the
  // paywall itself is UI-only (no SDK wired up, no feature actually
  // gated on this yet), see README.
  subscriptionStatus     String           @default("free")
  // Fired automatically by the Fleet Telemetry ingestor when it records an
  // "activityDetected" entry (aware/panic) — none | honk | flash | lock.
  sentryAutoAction       String           @default("none")
  // Scheduled Sentry activation window, applied server-side (see
  // src/scheduler/sentrySchedule.ts) so it runs even with the app closed —
  // start/end are "HH:mm" local to sentryScheduleTimezone; end < start
  // means the window wraps past midnight. Days are ISO weekday numbers
  // (1=Monday..7=Sunday) as a comma-separated string.
  sentryScheduleEnabled  Boolean          @default(false)
  sentryScheduleStart    String           @default("20:00")
  sentryScheduleEnd      String           @default("07:00")
  sentryScheduleDays     String           @default("1,2,3,4,5,6,7")
  sentryScheduleTimezone String           @default("Europe/Paris")
  createdAt              DateTime         @default(now())
  teslaCredential        TeslaCredential?
}

model TeslaCredential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

// Populated by the Fleet Telemetry ingestor (src/telemetry/ingestor.ts),
// which subscribes to the SentryModeState and connectivity signals streamed
// directly from the vehicle — not polled. See deploy/README.md.
model SentryTimelineEntry {
  id                  String   @id @default(uuid())
  vin                 String
  date                DateTime
  kind                String // vehicleOnline | vehicleOffline | sentryModeEnabled | sentryModeDisabled | activityDetected
  activityDescription String?
  awarenessLevel      String? // aware | panic — only set when kind == activityDetected
  // Battery level (0-100) at the time of this entry, from the Fleet
  // Telemetry "Soc" signal — only set on sentryModeEnabled/Disabled
  // entries. Paired client-side to show what was consumed during a Sentry
  // session (see EventTimelineView) — this is total vehicle consumption
  // while parked with Sentry on, not draw isolated to Sentry itself.
  batteryLevelPercent Int?
  isNew               Boolean  @default(true)
  createdAt           DateTime @default(now())

  @@index([vin, date])
}
