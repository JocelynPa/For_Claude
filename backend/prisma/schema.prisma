generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  teslaCredential TeslaCredential?
  vehicles        Vehicle[]
  subscription    Subscription?
  pushTokens      PushToken[]
}

/// Token de push Expo de l'appareil de l'utilisateur (un utilisateur peut en
/// avoir plusieurs : plusieurs appareils, ou token renouvelé).
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Tokens OAuth Tesla de l'utilisateur. Le refresh token ne quitte jamais le backend.
model TeslaCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teslaId     String   @unique
  vin         String
  displayName String

  /// Alertes de mouvement inattendu (activées/désactivées par l'utilisateur,
  /// mais aussi vérifiées côté serveur contre l'abonnement premium avant
  /// d'envoyer quoi que ce soit).
  alertsEnabled  Boolean   @default(false)
  /// Dernier instantané connu, utilisé pour détecter les changements lors du
  /// prochain sondage (voir services/vehicleAlerts.ts).
  lastLatitude   Float?
  lastLongitude  Float?
  lastLocked     Boolean?
  lastSentryMode Boolean?
  lastPolledAt   DateTime?

  drivingSessions DrivingSession[]

  @@index([userId])
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revenueCatAppUserId   String    @unique
  entitlement           String
  isActive              Boolean   @default(false)
  expiresAt             DateTime?
  store                 String
  updatedAt             DateTime  @updatedAt
}

model DrivingSession {
  id                 String   @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startedAt          DateTime
  endedAt            DateTime
  distanceKm         Float
  energyUsedKwh      Float
  efficiencyWhPerKm  Float
  averageSpeedKmh    Float

  @@index([vehicleId, startedAt])
}
