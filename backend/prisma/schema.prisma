generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String           @id @default(uuid())
  teslaSubject       String?          @unique
  email              String           @unique
  subscriptionStatus String           @default("free")
  createdAt          DateTime         @default(now())
  teslaCredential    TeslaCredential?
}

model TeslaCredential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  updatedAt    DateTime @updatedAt
}
