# Serveur
PORT=3000
NODE_ENV=development
SESSION_JWT_SECRET=change-me-to-a-long-random-string

# Base de données
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tesla_companion

# Tesla Developer (developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://api.your-domain.com/auth/tesla/callback
# Vérifie le claim "aud" de ton token OAuth Tesla (decode-le sur jwt.io) pour
# confirmer le bon nom d'hôte — Tesla en a déjà changé par le passé.
TESLA_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com

# Proxy de signature Tesla Vehicle Command (sidecar exécutant le binaire officiel `tesla-http-proxy`)
# https://github.com/teslamotors/vehicle-command
TESLA_COMMAND_PROXY_URL=https://localhost:4443

# Clé publique/privée générées avec vehicle-command pour la signature des commandes.
# Voir backend/keys/README.md
TESLA_PUBLIC_KEY_PATH=./keys/com.tesla.3p.public-key.pem

# RevenueCat
REVENUECAT_WEBHOOK_AUTH_HEADER=change-me-shared-secret
REVENUECAT_SECRET_API_KEY=
