PORT=3000
DATABASE_URL=postgresql://tesla_companion:tesla_companion@localhost:5432/tesla_companion
JWT_SECRET=replace-with-a-long-random-string
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://your-domain.example.com/auth/tesla/callback
TESLA_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_COMMAND_PROXY_URL=https://localhost:4443
TESLA_COMMAND_PROXY_INSECURE_TLS=true
APP_REDIRECT_SCHEME=teslacompanion
REVENUECAT_WEBHOOK_SECRET=

# Fleet Telemetry (Sentry timeline) — all optional, backend runs fine
# without them, the Sentry timeline just stays empty. See deploy/README.md.
REDIS_URL=
FLEET_TELEMETRY_NAMESPACE=tesla_telemetry
FLEET_TELEMETRY_HOSTNAME=
FLEET_TELEMETRY_PORT=443
FLEET_TELEMETRY_CA_FILE=

# Push notifications (APNs) — optional, backend runs fine without them, it
# just won't send a push when Sentry activity is detected. See
# deploy/README.md.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=com.teslacompanion.app
APNS_PRODUCTION=false
