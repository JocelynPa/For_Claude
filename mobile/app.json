{
  "expo": {
    "name": "Tesla Companion",
    "slug": "tesla-companion",
    "scheme": "teslacompanion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.teslacompanion",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Utilisée pour afficher la position de votre véhicule et calculer vos statistiques de trajet."
      }
    },
    "android": {
      "package": "com.yourcompany.teslacompanion",
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E82127"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://api.your-domain.com",
      "eas": {
        "projectId": "442402f5-3d7e-46c2-a7dd-c9a9121c0908"
      }
    }
  }
}
