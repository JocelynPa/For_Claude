EXPO_PUBLIC_API_BASE_URL=https://api.your-domain.com
EXPO_PUBLIC_TESLA_CLIENT_ID=your-tesla-developer-client-id
# Doit être identique, caractère pour caractère, à TESLA_REDIRECT_URI côté
# backend et à l'URI de redirection enregistrée dans le Tesla Developer
# Portal (Tesla n'accepte que des URI HTTPS pré-enregistrées).
EXPO_PUBLIC_TESLA_REDIRECT_URI=https://api.your-domain.com/auth/tesla/callback
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx

# Doit correspondre à MOCK_TESLA_DATA côté backend — affiche les boutons de
# simulation d'événements dans Réglages en mode démo.
EXPO_PUBLIC_MOCK_MODE=false
