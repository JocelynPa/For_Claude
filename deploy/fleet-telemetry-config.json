{
  "host": "0.0.0.0",
  "port": 443,
  "log_level": "info",
  "json_log_enable": true,
  "namespace": "tesla_telemetry",
  "reliable_ack": false,
  "transmit_decoded_records": true,
  "records": {
    "V": ["redis"],
    "connectivity": ["redis"],
    "alerts": ["logger"],
    "errors": ["logger"]
  },
  "redis": {
    "addrs": ["redis:6379"],
    "publish_vin_topics": true
  },
  "tls": {
    "server_cert": "/etc/letsencrypt/live/REPLACE_WITH_FLEET_TELEMETRY_HOSTNAME/fullchain.pem",
    "server_key": "/etc/letsencrypt/live/REPLACE_WITH_FLEET_TELEMETRY_HOSTNAME/privkey.pem"
  }
}
