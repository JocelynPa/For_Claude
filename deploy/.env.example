# Used both by docker-compose.yml for interpolation (${DOMAIN}, etc.) and
# passed wholesale to the backend container via env_file.

DOMAIN=tesla.jp-engineering.fr

# NOTE: POSTGRES_PASSWORD is used twice — once to configure the postgres
# service itself, and once embedded in DATABASE_URL below. Keep both in sync
# if you change it.
POSTGRES_PASSWORD=change-me

PORT=3000
DATABASE_URL=postgresql://tesla_companion:change-me@postgres:5432/tesla_companion
JWT_SECRET=replace-with-a-long-random-string
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://tesla.jp-engineering.fr/auth/tesla/callback
TESLA_AUDIENCE=https://fleet-api.prd.eu.vn.cloud.tesla.com
# Service name from docker-compose.yml, not localhost — reachable only
# inside the Docker network.
TESLA_COMMAND_PROXY_URL=https://tesla-proxy:4443
TESLA_COMMAND_PROXY_INSECURE_TLS=true
APP_REDIRECT_SCHEME=teslacompanion
REVENUECAT_WEBHOOK_SECRET=
